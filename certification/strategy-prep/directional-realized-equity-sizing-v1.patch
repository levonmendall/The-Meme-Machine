diff --git a/certification/sleeve_reservations.py b/certification/sleeve_reservations.py
--- a/certification/sleeve_reservations.py
+++ b/certification/sleeve_reservations.py
@@
 class SleeveReservations:
+    def sizing_basis(self,target_bps,*,minimum_bps=0):
+        """Deterministic realized-equity sizing; unrealized marks have no authority."""
+        if (type(target_bps) is not int or not 0 < target_bps <= 10_000
+                or type(minimum_bps) is not int or not 0 <= minimum_bps <= target_bps):
+            raise ValueError('directional_sizing_bps')
+        state=self.reconcile()
+        equity=state['capital']+state['realized']
+        if equity <= 0:
+            target=minimum=allocatable=0
+        else:
+            target=equity*target_bps//10_000
+            minimum=equity*minimum_bps//10_000
+            allocatable=min(target,state['available'])
+        return dict(genesis_capital=state['capital'],realized_pnl=state['realized'],
+            realized_equity=equity,reserved=state['reserved'],available=state['available'],
+            target_bps=target_bps,minimum_bps=minimum_bps,target=target,
+            minimum=minimum,allocatable_target=allocatable)
+
