+class PaginationCursorRegression(unittest.TestCase):
+    def test_backfill_preserves_provider_order_with_multiple_signatures_in_one_slot(self):
+        class Rpc:
+            def __init__(self):self.cursors=[]
+            def call(self,method,params,priority):
+                before=params[1]['before'];self.cursors.append(before)
+                pages={'s4':[('s3',102,2),('s2',102,2)],'s2':[('s1',99,1)]}
+                return [dict(signature=s,blockTime=t,slot=b,err=None) for s,t,b in pages[before]]
+        h=IncrementalPumpSwapHistory('pool',100,page_limit=2,max_backfill_pages=1)
+        h._remember([dict(signature='s4',blockTime=104,slot=4,err=None)])
+        rpc=Rpc();h._backfill(rpc);h._backfill(rpc)
+        self.assertEqual(rpc.cursors,['s4','s2'])
+        self.assertTrue(h.signature_coverage_complete)
+        h._backfill(rpc)
+        self.assertEqual(len(rpc.cursors),2)
