@@ -0,0 +1,56 @@
+import unittest
+from types import SimpleNamespace
+from unittest.mock import MagicMock,patch
+
+from robinhood_research import pons_selective_acquisition as acquisition
+
+
+class PonsStrategyScopeEfficiencyTests(unittest.TestCase):
+    def test_trajectory_static_rejection_skips_market_window(self):
+        ctx=MagicMock()
+        ctx.telemetry.return_value={}
+        ctx.acquire.return_value.telemetry.return_value={}
+        candidate=dict(
+            token='token',curve='curve',block=1,
+            state=SimpleNamespace(real_quote=6000,graduated=False,creator_tax_bps=0),
+            record={'graduationThreshold':10000,'pairToken':'0x'+'00'*20},
+            current_snipe_bps=0,
+            decoded_event={'decoded':{'name':'CurveBuy'}},
+            stamp=SimpleNamespace(event_at=100),
+        )
+        event=dict(blockNumber='0x1',blockHash='hash',transactionHash='tx',logIndex='0x0')
+        with patch.object(acquisition,'_authenticate_candidate',return_value=candidate), \
+             patch.object(acquisition,'strategy_prospect_preflight',return_value={'eligible':True,'reasons':[],'progress_bps':6000}), \
+             patch.object(acquisition,'_trajectory',return_value=([{'at':85,'progress_bps':5500}],0,{})), \
+             patch.object(acquisition,'strategy_trajectory_preflight',return_value={'eligible':False,'reasons':['graduation_eta'],'trajectory':{},'token_age_seconds':100}), \
+             patch.object(acquisition,'_authenticate_window') as window:
+            row=acquisition.evaluate_candidate(
+                'unused',event,[],strategy_capital_quote=100,evidence_context=ctx,
+            )
+        self.assertTrue(row['screened_out'])
+        self.assertEqual(row['vector']['qualification'],'strategy_trajectory_screen')
+        self.assertIn('graduation_eta',row['vector']['all_rejections'])
+        window.assert_not_called()
+
+    def test_trajectory_preflight_uses_frozen_age_and_trajectory_rules(self):
+        candidate={'stamp':SimpleNamespace(event_at=500)}
+        with patch.object(acquisition,'trajectory_metrics',return_value=dict(
+            complete=True,progress_15s_bps=400,accelerating=True,
+            graduation_eta_seconds=45,
+        )):
+            ok=acquisition.strategy_trajectory_preflight(candidate,[],100)
+        self.assertTrue(ok['eligible'],ok)
+        with patch.object(acquisition,'trajectory_metrics',return_value=dict(
+            complete=True,progress_15s_bps=100,accelerating=False,
+            graduation_eta_seconds=200,
+        )):
+            bad=acquisition.strategy_trajectory_preflight(candidate,[],450)
+        self.assertFalse(bad['eligible'])
+        self.assertIn('token_age',bad['reasons'])
+        self.assertIn('curve_velocity',bad['reasons'])
+        self.assertIn('curve_deceleration',bad['reasons'])
+        self.assertIn('graduation_eta',bad['reasons'])
+
+
+if __name__=='__main__':
+    unittest.main()
