+++ b/robinhood_tests/test_ramses_strategy_scope_efficiency.py
@@ -0,0 +1,34 @@
+import unittest
+
+from robinhood_research.ramses_universe import _strategy_activity_cohort
+
+
+class RamsesStrategyScopeEfficiencyTests(unittest.TestCase):
+    def test_quiet_domain_is_filter_not_ranking_preference(self):
+        addresses=['zero','one','two','hot']
+        histories={
+            'one':[{'block':11}],
+            'two':[{'block':12},{'block':13}],
+            'hot':[{'block':14},{'block':15},{'block':16}],
+        }
+        rows=_strategy_activity_cohort(addresses,histories,10)
+        by_pool={row['pool']:row for row in rows}
+        self.assertNotIn('hot',by_pool)
+        self.assertEqual(by_pool['zero']['swaps'],0)
+        self.assertEqual(by_pool['one']['swaps'],1)
+        self.assertEqual(by_pool['two']['swaps'],2)
+        self.assertLess([r['pool'] for r in rows].index('one'),[r['pool'] for r in rows].index('zero'))
+
+    def test_capacity_is_spent_only_inside_quiet_domain(self):
+        addresses=['hot1','hot2','quiet','zero']
+        histories={
+            'hot1':[{'block':1},{'block':2},{'block':3}],
+            'hot2':[{'block':4},{'block':5},{'block':6},{'block':7}],
+            'quiet':[{'block':8}],
+        }
+        rows=_strategy_activity_cohort(addresses,histories,2)
+        self.assertEqual({row['pool'] for row in rows},{'quiet','zero'})
+
+
+if __name__=='__main__':
+    unittest.main()
