+def _strategy_activity_cohort(addresses,histories,limit):
+    """Return only the frozen <=2-swap domain, including literal zero-swap pools.
+
+    One/two-swap pools stay ahead of zero-swap pools, while pools already outside
+    the strategy's quiet-entry domain never receive authoritative state work.
+    """
+    rows=[]
+    for address in addresses:
+        history=list(histories.get(address) or ())
+        swaps=len(history)
+        if swaps>2:
+            continue
+        rows.append(dict(
+            pool=address,swaps=swaps,
+            latest_swap_block=max((r["block"] for r in history),default=0),
+        ))
+    rows.sort(key=lambda r:(
+        1 if 0<r["swaps"]<=2 else 0,
+        -abs(r["swaps"]-1),r["latest_swap_block"],r["pool"],
+    ),reverse=True)
+    return rows[:limit]
+
