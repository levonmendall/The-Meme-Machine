+    def test_completed_rejection_closes_trigger_and_supersession_is_separate(self):
+        with tempfile.TemporaryDirectory() as td:
+            path=Path(td)/"pipeline.sqlite"
+            pipeline=Pipeline(path,"meteora","frozen");active={}
