+    def test_original_trigger_wait_limit_keeps_failed_fresh_state_distinct_from_no_activity(self):
+        result,calls,_,_,_=self.run_trigger(
+            lambda now:dict(gaps=0,covered=True),lambda *_:self.swap(),
