+class NegativeHistoryReuseTests(unittest.TestCase):
+    def test_known_negative_cannot_reenter_hydration_or_poison_complete_window(self):
+        broker=EvidenceBroker(':memory:',clock=lambda:105,sleeper=lambda _:None)
+        self.addCleanup(broker.close)
+        broker.stream_begin('pool:one',70)
+        broker.record_event('pool:one',signature='s5',slot=5,observed_at=105,
+            payload=dict(err=None,logs=['Program Other111 invoke [1]','Program Other111 success']))
+        history=IncrementalPumpSwapHistory('pool',100,broker=broker,stream_key='pool:one')
+        rpc=FakeRPC();history._ingest_stream_window(rpc,105)
+        self.assertIn('s5',history.stream_prefiltered_signatures)
+        history._remember([dict(signature='s5',slot=5,blockTime=105,err=None)])
+        history.history_exhausted=True;history._coverage()
+        self.assertEqual(history.pending_relevant(105),0)
+        self.assertTrue(history.decision_window_status(105)['complete'])
+        self.assertTrue(history.complete(105))
+        for kind in ('pump_window','research_history'):history._decode_pending(rpc,105,kind)
+        self.assertEqual(rpc.tx_calls,[])
+        self.assertNotIn('s5',history.processed)
+        self.assertEqual(history.rows(105),[])
+        # Another pool's history gains no exclusion or body authority.
+        other=IncrementalPumpSwapHistory('other',100)
+        other._remember([dict(signature='s5',slot=5,blockTime=105,err=None)])
+        self.assertEqual(other.pending_relevant(105),1)
+        other._decode_pending(rpc,105)
+        self.assertEqual(rpc.tx_calls,['s5'])
+
+    def test_missing_or_truncated_logs_still_require_transaction_bodies(self):
+        for payload in ({},dict(err=None,logs=['Log truncated'])):
+            with self.subTest(payload=payload):
+                broker=EvidenceBroker(':memory:',clock=lambda:105,sleeper=lambda _:None)
+                try:
+                    broker.stream_begin('pool:one',70)
+                    broker.record_event('pool:one',signature='s5',slot=5,observed_at=105,payload=payload)
+                    history=IncrementalPumpSwapHistory('pool',100,broker=broker,stream_key='pool:one')
+                    rpc=FakeRPC();history._ingest_stream_window(rpc,105)
+                    self.assertNotIn('s5',history.stream_prefiltered_signatures)
+                    self.assertEqual(rpc.tx_calls,['s5'])
+                finally:broker.close()
