@@ -0,0 +1,15 @@
+import unittest
+from types import SimpleNamespace
+from tests.pump_acceleration_natural_prospective import _needs_postgrad_concentration
+
+class PumpStrategyScopeEfficiencyTests(unittest.TestCase):
+    def test_holder_scan_only_when_an_optimistic_mode_can_qualify(self):
+        no=SimpleNamespace(qualified=False)
+        yes=SimpleNamespace(qualified=True)
+        self.assertFalse(_needs_postgrad_concentration(no))
+        self.assertFalse(_needs_postgrad_concentration(no,no))
+        self.assertTrue(_needs_postgrad_concentration(yes,no))
+        self.assertTrue(_needs_postgrad_concentration(no,yes))
+
+if __name__=='__main__':
+    unittest.main()
