+def _state_reader(endpoint,count,frontier):
+    """Fund the exact frozen wide-state workload, independently of metadata reads.
+
+    The old seven-session metadata budget cannot contain even four 408-read
+    prestates. Rates, retries, candidate capacity and the full 201-bin range stay
+    fixed. Only the unintended undersized local state-work bound is corrected.
+    """
+    if type(count) is not int or not 1<=count<=WIDE_HYDRATION_COHORT_SIZE:
+        raise BoundaryError('ramses_state_reader_candidate_bound')
+    per_pool=6+2*(2*WIDE_STATE_RADIUS+1)
+    planned=1+count*per_pool  # Same-chain authentication plus native view reads.
+    effective_session_capacity=200-UNIVERSE_BATCH_SIZE+1
+    sessions=(planned+effective_session_capacity-1)//effective_session_capacity
+    rpc=BoundedMultiRpc(endpoint,max_sessions=sessions,batch_size=UNIVERSE_BATCH_SIZE,
+        batch_pause=UNIVERSE_BATCH_PAUSE_SECONDS,rate_retries=UNIVERSE_RATE_RETRIES,
+        rate_cooldown=UNIVERSE_RATE_COOLDOWN_SECONDS,adaptive_batch_floor=2,
+        provider_role='authoritative')
+    rpc.evidence_pins={frontier['number']:frontier['hash']}
+    rpc.scan_budget=dict(candidate_count=count,bins_per_pool=2*WIDE_STATE_RADIUS+1,
+        logical_reads_per_pool=per_pool,planned_logical_reads=planned,
+        max_sessions=sessions,program_logical_limit=200*sessions,
+        metadata_program_logical_limit=1400,throughput_and_retries_unchanged=True)
+    rpc.verify_chain()
+    return rpc
+
