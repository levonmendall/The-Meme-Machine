+    def _finalized_stream_trade_evidence(self,row):
+        """Classify one finalized candidate-pool log notification.
+
+        Complete PumpSwap TradeEvent logs are authoritative only for the exact
+        fields carried by that program event. Missing/truncated/unsupported
+        PumpSwap program data remains a body-hydration fallback. Failed
+        transactions and complete logs with no target-pool event are safe
+        negatives.
+        """
+        payload=row.get("payload") or {}
+        logs=payload.get("logs")
+        if not isinstance(logs,list) or not logs or not all(isinstance(x,str) for x in logs):
+            return "fallback",[]
+        if any("truncat" in line.lower() for line in logs):
+            return "fallback",[]
+        if payload.get("err") is not None:
+            return "negative",[]
+        slot=int(row["slot"])
+        tx={"slot":slot,"meta":{"err":None,"logMessages":logs}}
+        events=pumpswap_trade_events(tx)
+        target=[dict(event) for event in events if event.get("pool")==self.pool]
+        if target:
+            signature=str(row.get("signature") or "")
+            digest=hashlib.sha256(json.dumps(
+                payload,sort_keys=True,separators=(",",":")).encode()).hexdigest()
+            for event in target:
+                event.update(
+                    id=f'{signature}:{event["index"]}',
+                    evidence_source="finalized_pumpswap_program_log",
+                    evidence_signature=signature,
+                    evidence_payload_sha256=digest,
+                )
+            return "authoritative",target
+
+        # pumpswap_trade_events intentionally ignores unsupported event
+        # discriminators. If PumpSwap emitted program data that we did not
+        # understand, require the immutable transaction body rather than
+        # silently treating that notification as a negative.
+        stack=[];pump_data=False
+        for line in logs:
+            if line.startswith("Program ") and " invoke [" in line:
+                stack.append(line.split()[1])
+            elif line.startswith("Program ") and (" success" in line or " failed:" in line):
+                if stack:stack.pop()
+            elif line.startswith("Program data: ") and stack and stack[-1]==PUMPSWAP_PROGRAM:
+                pump_data=True
+        return ("fallback" if pump_data else "negative"),[]
+
