index 4786f84e2f87561846fc8f504b239e77a1fa6724..6764c9cee69e33fc5004c9901155ec080d468e03 100644
--- a/robinhood_research/abi.py
+++ b/robinhood_research/abi.py
@@ -83,3 +83,14 @@ def decode_event(abi, event):
     for spec_i, value in zip(plain, data):
         out[spec_i['name']] = scalar(spec_i['type'], value)
     return dict(name=spec['name'], signature=signature(spec), args=out)
+
+
+def receipt_log_matches(event,receipt_log):
+    """Compare exact log identity/payload; header alone authenticates event time.
+
+    Robinhood public getLogs can append blockTimestamp=0x0 while the receipt
+    supplies the real value. That optional provider annotation is not log identity.
+    Preserve every other field comparison, including unknown extensions.
+    """
+    return ({k:v for k,v in event.items() if k!='blockTimestamp'} ==
+            {k:v for k,v in receipt_log.items() if k!='blockTimestamp'})
