+def _enable_wal(db, *, timeout=30.0, monotonic=time.monotonic, sleeper=time.sleep):
+    """Bound only the startup journal transition; never retry evidence or provider work.
+
+    SQLite can return SQLITE_BUSY immediately for a concurrent journal-mode
+    transition even when the connection has a busy timeout. Use one monotonic
+    deadline and retry only BUSY/LOCKED, before any schema or consumer is created.
+    """
+    deadline = monotonic() + timeout
+    db.execute("PRAGMA busy_timeout=0")
+    try:
+        while True:
+            try:
+                return db.execute("PRAGMA journal_mode=WAL").fetchone()[0]
+            except sqlite3.OperationalError as error:
+                code = getattr(error, "sqlite_errorcode", None)
+                if code is None or (code & 255) not in (sqlite3.SQLITE_BUSY, sqlite3.SQLITE_LOCKED):
+                    raise
+                remaining = deadline - monotonic()
+                if remaining <= 0:
+                    raise
+                sleeper(min(0.05, remaining))
+    finally:
+        db.execute("PRAGMA busy_timeout=30000")
