+class UnfilledReservationRecovery(unittest.TestCase):
+    setUp=DurableIndependentAccounting.setUp
+    reopen=DurableIndependentAccounting.reopen
+    def test_restart_releases_unfilled_once_and_cannot_fill_cancelled_intent(self):
+        identity=self.book.identity()
+        self.book.append(identity,'reserve',dict(amount=1_000_000))
+        before=self.reopen().reconcile()
+        self.assertEqual(before['pending'],1)
+        self.assertEqual(self.reopen().recover_unfilled_reservations(),[identity])
+        after=self.reopen().reconcile()
+        self.assertEqual((after['cash'],after['reserved'],after['pending']),
+                         (1_000_000_000,0,0))
+        self.assertEqual(after['journal_events'],before['journal_events']+1)
+        self.assertEqual(self.reopen().recover_unfilled_reservations(),[])
+        self.assertEqual(self.reopen().reconcile(),after)
+        with self.assertRaisesRegex(ValueError,'entry_reservation'):
+            self.book.append(identity,'entry',dict(capital=800_000,entry_cost=100_000,exit_cost=100_000))
+        self.assertEqual(self.reopen().reconcile(),after)
+
+    def test_filled_unresolved_inventory_is_retained_while_pending_is_released(self):
+        def fail(*args):return dict(verified=False,reason='synthetic_evidence_missing'),None,None,None,None
+        with patch.object(strategy,'_rotate',side_effect=lambda a,*args:a),patch.object(strategy,'_observe_window',side_effect=fail):
+            strategy._lifecycle(None,self.entry['pool'],self.entry,self.features,self.policy,None,[],book=self.book)
+        before=self.reopen().reconcile();identity=self.book.identity()
+        self.book.append(identity,'reserve',dict(amount=1000))
+        self.assertEqual(self.reopen().recover_unfilled_reservations(),[identity])
+        after=self.reopen().reconcile()
+        for key in ('cash','reserved','open_positions','unsettled','stale_marks',
+                    'realized_pnl_lamports','unrealized_pnl_lamports','marked_equity'):
+            self.assertEqual(after[key],before[key],key)
+
+    def test_cancel_batch_rolls_back_at_interrupted_commit_cut(self):
+        identities=[self.book.identity(),self.book.identity()]
+        for identity in identities:self.book.append(identity,'reserve',dict(amount=1000))
+        before=self.reopen().reconcile();apply=self.book._apply;seen=[]
+        def crash(state,event):
+            if event['action']=='cancel':
+                seen.append(event['identity'])
+                if len(seen)==2:raise SystemExit('crash before cancel commit')
+            return apply(state,event)
+        with patch.object(self.book,'_apply',side_effect=crash):
+            with self.assertRaises(SystemExit):self.book.recover_unfilled_reservations()
+        self.assertEqual(self.reopen().reconcile(),before)
+        self.assertEqual(self.reopen().recover_unfilled_reservations(),identities)
