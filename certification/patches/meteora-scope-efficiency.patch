index 0000000..02f0ddc
--- /dev/null
+++ b/tests/test_meteora_strategy_scope_efficiency.py
@@ -0,0 +1,44 @@
+import unittest
+from unittest.mock import patch
+
+from tests import solana_dlmm_independent_v1 as runner
+
+
+class MeteoraStrategyScopeEfficiencyTests(unittest.TestCase):
+    def candidate_row(self):
+        return dict(
+            address='pool',name='pool',
+            token_x={'address':runner.dlmm.WSOL},token_y={'address':'token'},
+            tvl=1000,volume={'30m':100},fees={'30m':10},dynamic_fee_pct=1,
+        )
+
+    def test_discovery_does_not_request_historical_acceleration(self):
+        telemetry={}
+        policy={'regime':{}}
+        with patch.object(runner,'DISCOVERY_SORTS',('fee_tvl_ratio_5m:desc',)), \
+             patch.object(runner,'DISCOVERY_PAGES_PER_SORT',1), \
+             patch.object(runner,'_api',return_value={'data':[self.candidate_row()]}), \
+             patch.object(runner,'_history_acceleration',side_effect=AssertionError('history should not run')) as history:
+            rows=list(runner._iter_acceleration_candidates(policy,telemetry))
+        self.assertEqual(len(rows),1)
+        self.assertEqual(telemetry['history_reads'],0)
+        self.assertEqual(telemetry['public_history_reads_avoided'],1)
+        history.assert_not_called()
+
+    def test_fresh_swap_wait_does_not_refresh_public_history(self):
+        from types import SimpleNamespace
+        adapter=SimpleNamespace(rpc=object());candidate={'address':'pool','fee_30m_snapshot_usd':1,'tvl_usd':100}
+        with patch.object(runner,'_rotate',side_effect=lambda a,p,r:a), \
+             patch.object(runner,'_new_finalized_swaps',return_value=([{'slot':2}],{'rate_limited':False,'head_slot':2})), \
+             patch.object(runner,'_retry_rate_limited_operation',return_value=({'slot':2},adapter)), \
+             patch.object(runner,'_history_acceleration',side_effect=AssertionError('history should not run')) as history:
+            trigger,post,_,_=runner._await_fresh_swap_trigger_polling(
+                adapter,candidate,{'slot':1},{},None,[],deadline=None)
+        self.assertTrue(trigger['triggered'])
+        self.assertEqual(post['slot'],2)
+        self.assertEqual(trigger['acceleration_refreshes'],0)
+        history.assert_not_called()
+
+
+if __name__=='__main__':
+    unittest.main()
