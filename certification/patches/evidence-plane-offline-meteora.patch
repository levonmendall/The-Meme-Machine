+                warning_bytes=STORAGE_WARNING_BYTES, critical_bytes=STORAGE_CRITICAL_BYTES,
+                state=('critical' if remaining < STORAGE_CRITICAL_BYTES else
+                       'warning' if remaining < STORAGE_WARNING_BYTES else 'ok'))
