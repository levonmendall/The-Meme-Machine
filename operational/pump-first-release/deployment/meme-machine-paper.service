[Unit]
Description=Meme Machine autonomous PAPER service
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/volume_nyc1_1790918115030/meme-machine-paper-v1
RequiresMountsFor=/mnt/volume_nyc1_1790918115030/meme-machine-paper-shared-1000
BindsTo=mnt-volume_nyc1_1790918115030.mount
After=mnt-volume_nyc1_1790918115030.mount
AssertPathIsMountPoint=/mnt/volume_nyc1_1790918115030

[Service]
Type=simple
User=meme-machine
Group=meme-machine
WorkingDirectory=/opt/meme-machine
EnvironmentFile=/etc/meme-machine/paper.shared-1000.env
Environment=MM_PAPER_ENV_FILE=/etc/meme-machine/paper.shared-1000.env
ExecStartPre=/opt/meme-machine/.venv/bin/python -m meme_machine.operational.storage_guard
ExecStart=/opt/meme-machine/.venv/bin/python -m meme_machine.operational run
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=90
CPUQuota=180%
MemoryHigh=6G
MemoryMax=7G
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
