+name: Evidence-gated canonical Phase E promotion
+on:
+  workflow_dispatch:
+    inputs:
+      expected_sha:
+        description: Exact candidate already accepted by all four fixed trials and full machinery verification
+        type: string
+        required: true
+      expected_canonical_sha:
+        description: Exact current canonical predecessor; compare-and-swap only
+        type: string
+        required: true
+      cohort_run_id:
+        description: Completed exact-SHA run containing all four fixed trials and environment.json
+        type: string
+        required: true
+      cohort_artifact:
+        description: Artifact name containing original trial directories, not an aggregate alone
+        type: string
+        required: true
+      full_run_id:
+        description: Completed exact-SHA full machinery verification run after cohort acceptance
+        type: string
+        required: true
+permissions:
+  contents: read
+concurrency:
+  group: canonical-phase-e-promotion
+  cancel-in-progress: false
+jobs:
+  promote-and-dispatch:
+    permissions:
+      contents: write
+      actions: write
+    outputs:
+      canonical_run_id: ${{ steps.promote.outputs.canonical_run_id }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          fetch-depth: 0
+      - name: Bind manual attempt to immutable candidate before Python execution
+        env:
+          EXPECTED_SHA: ${{ inputs.expected_sha }}
+        run: |
+          set -euo pipefail
+          test "$GITHUB_EVENT_NAME" = workflow_dispatch
+          test "$GITHUB_RUN_ATTEMPT" = 1
+          test "$GITHUB_SHA" = "$EXPECTED_SHA"
+          test "$(git rev-parse HEAD)" = "$EXPECTED_SHA"
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.14'
+      - run: python -m pip install --disable-pip-version-check -r requirements.txt
+      - name: Reverify raw proofs, reserve one-shot intent, promote and explicitly dispatch
+        id: promote
+        env:
+          GH_TOKEN: ${{ github.token }}
+          EXPECTED_SHA: ${{ inputs.expected_sha }}
+          PRIOR_SHA: ${{ inputs.expected_canonical_sha }}
+          COHORT_RUN: ${{ inputs.cohort_run_id }}
+          COHORT_ARTIFACT: ${{ inputs.cohort_artifact }}
+          FULL_RUN: ${{ inputs.full_run_id }}
+        run: |
+          set -euo pipefail
+          python -m certification.promote_phase_e \
+            --sha "$EXPECTED_SHA" --old-sha "$PRIOR_SHA" \
+            --cohort-run "$COHORT_RUN" --cohort-artifact "$COHORT_ARTIFACT" \
+            --full-run "$FULL_RUN" --output "$RUNNER_TEMP/phase-e-promotion"
+          python - <<'PYCODE'
+          import json, os
+          from pathlib import Path
+          row = json.loads((Path(os.environ['RUNNER_TEMP']) / 'phase-e-promotion/promotion.json').read_text())
+          assert type(row['run_id']) is int
+          with open(os.environ['GITHUB_OUTPUT'], 'a') as target:
+              target.write(f"canonical_run_id={row['run_id']}\n")
+          PYCODE
+      - name: Preserve success or failure without granting market authority
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: phase-e-promotion-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/phase-e-promotion/
+          retention-days: 90
+          if-no-files-found: error
+
+  review-canonical-artifacts:
+    needs: promote-and-dispatch
+    permissions:
+      contents: read
+      actions: read
+    runs-on: ubuntu-24.04
+    timeout-minutes: 95
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          fetch-depth: 0
+          persist-credentials: false
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
+        with:
+          python-version: '3.12.14'
+      - run: python -m pip install --disable-pip-version-check -r requirements.txt
+      - name: Read canonical run to completion and reverify its raw artifacts
+        env:
+          GH_TOKEN: ${{ github.token }}
+          EXPECTED_SHA: ${{ inputs.expected_sha }}
+          CANONICAL_RUN: ${{ needs.promote-and-dispatch.outputs.canonical_run_id }}
+        run: |
+          set -euo pipefail
+          test "$GITHUB_SHA" = "$EXPECTED_SHA"
+          test "$GITHUB_RUN_ATTEMPT" = 1
+          python -m certification.promote_phase_e --sha "$EXPECTED_SHA" \
+            --verify-run "$CANONICAL_RUN" --polls 360 \
+            --output "$RUNNER_TEMP/phase-e-canonical-review"
+      - name: Preserve canonical review even when the child workflow fails
+        if: always()
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
+        with:
+          name: phase-e-canonical-review-${{ github.sha }}-${{ github.run_id }}-${{ github.run_attempt }}
+          path: ${{ runner.temp }}/phase-e-canonical-review/
+          retention-days: 90
+          if-no-files-found: error
