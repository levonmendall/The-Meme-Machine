[Unit]
Description=Meme Machine coherent off-host DigitalOcean Volume backup
After=network-online.target meme-machine-paper.service
Wants=network-online.target
RequiresMountsFor=/mnt/volume_nyc1_1790918115030

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/meme-machine
EnvironmentFile=/etc/meme-machine/paper.env
Environment=MM_BACKUP_SYSTEMD=1
ExecStart=/opt/meme-machine/.venv/bin/python -m meme_machine.operational.digitalocean_backup
ExecStopPost=/usr/bin/systemctl thaw meme-machine-paper.service
StateDirectory=meme-machine-backup
StateDirectoryMode=0700
TimeoutStartSec=180
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
PrivateTmp=true
StandardOutput=journal
StandardError=journal
