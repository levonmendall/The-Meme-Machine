# Install once as /etc/meme-machine/paper.env, readable by the service account.
# Bind state to Droplet 605465049's existing persistent volume after verifying
# its current mount. Replace placeholders during deployment; no secrets in Git.
MM_MODE=PAPER
MM_STATE_ROOT=/replace/with/verified/persistent-volume/meme-machine-paper-v1
MM_SOLANA_READ_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/REPLACE_AT_DEPLOYMENT
MM_ROBINHOOD_READ_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_AT_DEPLOYMENT
