# Install once as /etc/meme-machine/paper.env, readable by the service account.
# Bind the separately authorized NEW $1,000 shared epoch to the verified volume.
# Preserve the historical $500 root, inception, guard and monetary accounting.
# Initialization and deployment require separate approval; this does neither.
MM_MODE=PAPER
MM_STATE_ROOT=/replace/with/verified/persistent-volume/meme-machine-paper-shared-1000
MM_STORAGE_GUARD_CONFIG=/etc/meme-machine/storage.shared-1000.json
MM_SOLANA_READ_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/REPLACE_AT_DEPLOYMENT
MM_ROBINHOOD_READ_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/REPLACE_AT_DEPLOYMENT
